APP_ENV=development

MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=60
MAX_OUTPUT_IMAGES=500
MAX_TOTAL_OUTPUT_MB=2048

JOB_RETENTION_MINUTES=60
TEMP_DIR=/tmp/video-to-image

# A result is deleted once this many distinct addresses have downloaded it.
MAX_DOWNLOAD_CLIENTS=3

# Fetching a video from a pasted URL
ALLOW_URL_UPLOADS=true
URL_FETCH_TIMEOUT_SECONDS=60
URL_MAX_REDIRECTS=3
# Leave false in public deployments: allowing private hosts turns this server
# into an SSRF proxy for its own network.
ALLOW_PRIVATE_URL_HOSTS=false

# Resolving a page that plays a video (YouTube and similar) with yt-dlp, for
# links that are not the video file itself. Set false to accept direct links
# only. Note that video sites often block datacenter IPs, so this is far more
# reliable from a home or office connection than from a cloud host.
ALLOW_MEDIA_SITE_URLS=true
# Tallest stream the extractor will pick.
MEDIA_SITE_MAX_HEIGHT=1080
# Total budget for resolving one page link, across every client attempted.
MEDIA_SITE_TIMEOUT_SECONDS=120

# Only needed if a site's bot check will not let up. Leave both empty to stay
# anonymous. A cookies.txt export (Netscape format) mounted into the container,
# or a browser to read cookies from ("chrome", "firefox", "safari", ...).
# Either one sends a logged-in session to the video site - your call.
# YOUTUBE_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# YOUTUBE_COOKIES_FROM_BROWSER=
# Where no file can be mounted (a serverless host), paste the cookies.txt
# contents instead. Set it as a SECRET, never in a committed file.
# YOUTUBE_COOKIES=

# Convert in a single request and stream the ZIP straight back, keeping no job
# on disk. Needed where consecutive requests may reach different instances (a
# serverless platform): the previews and downloads that follow an upload would
# otherwise 404 on a machine that never saw the job. Costs the preview grid.
STATELESS_CONVERSION=false

# Hard ceiling for decoding one job. No FFmpeg binary is needed: decoding runs
# in-process through PyAV, which bundles the libraries in its wheel.
PROCESS_TIMEOUT_SECONDS=600
